[Unit]
Description=my-ielts sync server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/my-ielts-sync
ExecStart=/usr/bin/node --experimental-sqlite /opt/my-ielts-sync/server.js
Restart=always
RestartSec=5
EnvironmentFile=-/etc/my-ielts-sync.env
Environment=DATA_DIR=/opt/my-ielts-sync/data
# JWT_SECRET 不设则首次启动自动生成并落盘到 DATA_DIR/.jwt_secret

[Install]
WantedBy=multi-user.target
